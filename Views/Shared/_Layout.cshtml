<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Conduce Seguro</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- Menu de navegacion -->
    <nav class="navbar navbar-expand-lg bg-dark sticky-top" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Conduce Seguro</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="nosotros">Nosotros</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="cursos">Cursos</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="vehiculos">Vehículos</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="tarifas">Tarifas</a>
                    <a class="nav-link" asp-controller="Inscripciones" asp-action="Create">Inscripción</a>
                    <a class="nav-link" asp-controller="Inscripciones" asp-action="Index">Inscritos</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Bootstrap: alert -->
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="container mt-4">
            <div class="alert alert-@(TempData["Tipo"] ?? "info") alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    @RenderBody()

    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">&copy; 2026 Conduce seguro - Escuela de conducción.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>