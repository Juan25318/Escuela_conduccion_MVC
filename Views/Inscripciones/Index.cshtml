@model ListadoInscripciones
@{
    ViewData["Title"] = "Estudiantes inscritos";
}

<main class="container py-5">
    <h1 class="text-center mb-4">Estudiantes inscritos</h1>

    
    <form class="row g-3 align-items-end mb-4" asp-controller="Inscripciones" asp-action="Index" method="get">
        <div class="col-12 col-md-5">
            <label for="cursoId" class="form-label">Filtrar por curso:</label>
            <select id="cursoId" name="cursoId" class="form-select">
                <option value="">Todos los cursos</option>
                @foreach (var curso in Model.Cursos)
                {
                    <option value="@curso.Id" selected="@(curso.Id == Model.CursoSeleccionado)">@curso.Nombre</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-7 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Quitar filtro</a>
            <a class="btn btn-success" asp-action="Create">Nueva inscripción</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Edad</th>
                    <th>Curso</th>
                    <th>Fecha</th>
                    <th>Total a pagar</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Inscripciones.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="sin-datos">Aún no hay inscripciones registradas.</td>
                    </tr>
                }

                @foreach (var insc in Model.Inscripciones)
                {
                    <tr>
                        <td>@insc.Id</td>
                        <td>@insc.Nombre</td>
                        <td>@insc.Telefono</td>
                        <td>@insc.Edad</td>
                        <td>@insc.Curso?.Nombre</td>
                        <td>@insc.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>@Formato.Dinero(insc.CalcularTotal())</td>
                        <td>
                            <!-- Formulario POST para eliminar -->
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar esta inscripción?');">
                                <input type="hidden" name="id" value="@insc.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Inscripciones.Count > 0)
    {
        <p class="fw-bold mb-0" id="totalRecaudado">
            Inscritos: @Model.Inscripciones.Count | Total a recaudar: @Formato.Dinero(Model.TotalRecaudado)
        </p>
    }
</main>